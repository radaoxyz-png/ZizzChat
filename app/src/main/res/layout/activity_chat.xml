<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0B1014">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:background="#0B1014">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="42dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_media_previous"
            android:contentDescription="Back"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:tint="#FFFFFF" />

        <TextView
            android:id="@+id/chatAvatar"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:gravity="center"
            android:background="@drawable/chat_avatar_bg"
            android:text="A"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/chatTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Friend"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Private chat"
                android:textColor="#AEB7BC"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/videoCallButton"
            android:layout_width="42dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_menu_camera"
            android:contentDescription="Video call"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:tint="#FFFFFF" />

        <ImageButton
            android:id="@+id/voiceCallButton"
            android:layout_width="42dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_menu_call"
            android:contentDescription="Voice call"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:tint="#FFFFFF" />

        <ImageButton
            android:id="@+id/chatMenuButton"
            android:layout_width="36dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_menu_more"
            android:contentDescription="More options"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:tint="#FFFFFF" />
    </LinearLayout>

    <!-- Messages -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/chatRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:clipToPadding="false"
        android:background="#0B1014"
        android:overScrollMode="never" />

    <!-- Message input -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="6dp"
        android:paddingBottom="8dp"
        android:background="#0B1014">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="6dp"
            android:background="@drawable/chat_composer_bg">

            <TextView
                android:id="@+id/emojiButton"
                android:layout_width="34dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:text="☻"
                android:textColor="#AEB7BC"
                android:textSize="25sp" />

            <EditText
                android:id="@+id/messageInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:maxHeight="120dp"
                android:hint="Message"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLength="2000"
                android:maxLines="4"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:background="@android:color/transparent"
                android:textColor="#FFFFFF"
                android:textColorHint="#89949A"
                android:textSize="16sp" />

            <ImageButton
                android:id="@+id/attachmentButton"
                android:layout_width="36dp"
                android:layout_height="48dp"
                android:src="@android:drawable/ic_menu_add"
                android:contentDescription="Attach"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:tint="#AEB7BC" />

            <ImageButton
                android:id="@+id/cameraButton"
                android:layout_width="36dp"
                android:layout_height="48dp"
                android:src="@android:drawable/ic_menu_camera"
                android:contentDescription="Camera"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:tint="#AEB7BC" />
        </LinearLayout>

        <Button
            android:id="@+id/sendButton"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_marginStart="8dp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="➤"
            android:textSize="25sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/chat_send_bg"
            android:contentDescription="Send message" />
    </LinearLayout>

</LinearLayout>
