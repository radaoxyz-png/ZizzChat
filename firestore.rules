rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function areFriends(uid1, uid2) {
      return (
        exists(/databases/$(database)/documents/friendRequests/$(uid1 + "_" + uid2))
        && get(/databases/$(database)/documents/friendRequests/$(uid1 + "_" + uid2)).data.status == "accepted"
      ) || (
        exists(/databases/$(database)/documents/friendRequests/$(uid2 + "_" + uid1))
        && get(/databases/$(database)/documents/friendRequests/$(uid2 + "_" + uid1)).data.status == "accepted"
      );
    }

    // User profiles
    match /users/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.auth.uid == userId;
      allow delete: if false;
    }

    // Friend requests
    match /friendRequests/{requestId} {
      allow read: if signedIn()
        && (
          resource.data.senderUid == request.auth.uid
          || resource.data.receiverUid == request.auth.uid
        );

      allow create: if signedIn()
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.receiverUid is string
        && request.resource.data.receiverUid != request.auth.uid
        && request.resource.data.status == "pending";

      allow update: if signedIn()
        && resource.data.receiverUid == request.auth.uid
        && resource.data.status == "pending"
        && request.resource.data.status in ["accepted", "rejected"]
        && request.resource.data.diff(resource.data)
             .affectedKeys().hasOnly(["status"]);

      allow delete: if false;
    }

    // Private chat rooms
    match /privateChats/{roomId} {

      allow read: if signedIn()
        && request.auth.uid in resource.data.participants;

      allow create: if signedIn()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants[0]
             != request.resource.data.participants[1]
        && areFriends(
          request.resource.data.participants[0],
          request.resource.data.participants[1]
        );

      allow update: if signedIn()
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants
             == resource.data.participants
        && request.resource.data.diff(resource.data)
             .affectedKeys().hasOnly(["updatedAt"]);

      allow delete: if false;

      // Messages in private rooms
      match /messages/{messageId} {

        function isParticipant() {
          return signedIn()
            && request.auth.uid in get(
              /databases/$(database)/documents/privateChats/$(roomId)
            ).data.participants;
        }

        allow read: if isParticipant();

        allow create: if isParticipant()
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.receiverUid is string
          && request.resource.data.receiverUid in get(
            /databases/$(database)/documents/privateChats/$(roomId)
          ).data.participants
          && request.resource.data.receiverUid != request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000;

        allow update, delete: if false;
      }
    }

    // Existing general-chat messages
    match /rooms/{roomId}/messages/{messageId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && request.resource.data.email == request.auth.token.email;

      allow update, delete: if false;
    }
  }
}
